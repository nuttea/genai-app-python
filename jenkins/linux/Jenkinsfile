// ─────────────────────────────────────────────────────────────────────────────
// Datadog Code Security — Jenkins Pipeline (Linux)
//
// Mirrors the GitHub Actions workflow at:
//   .github/workflows/datadog-code-security.yml
//
// Stages:
//   1. SAST Scan          — runs datadog-static-analyzer container, writes SARIF
//   2. Quality Gate       — parses SARIF, enforces severity threshold
//   3. SARIF → GitHub     — uploads SARIF to GitHub Code Scanning (optional)
//   4. SAST → Datadog  ┐  — runs in parallel, push/main branch only
//   5. SCA  → Datadog  ┘
//
// Required Jenkins credentials (Manage Jenkins → Credentials):
//   dd-api-key     Secret Text  — Datadog API key
//   dd-app-key     Secret Text  — Datadog Application key
//   github-token   Secret Text  — GitHub token with security_events scope
//                                 (optional, only needed for SARIF upload)
//
// Required Jenkins plugins:
//   Pipeline, Credentials Binding, Git, Timestamper, AnsiColor (optional)
//
// Agent requirements:
//   - Docker Engine installed and the Jenkins user in the 'docker' group
//   - Python 3 installed  (python3, pip3)
//   - curl installed
//   - internet access to pull ghcr.io/datadog/datadog-static-analyzer
// ─────────────────────────────────────────────────────────────────────────────

pipeline {
    agent { label 'linux && docker' }

    // ── Build-level options ───────────────────────────────────────────────────
    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(daysToKeepStr: '30', numToKeepStr: '50'))
        disableConcurrentBuilds()
        timestamps()
    }

    // ── Run-time parameters (mirrors GitHub Actions repo variables) ───────────
    parameters {
        booleanParam(
            name: 'DETECT_ONLY',
            defaultValue: true,
            description: '''true  → virtual-fail mode: HIGH+ findings emitted as warnings, CI never blocked
false → block mode: exits non-zero when violations at or above threshold exist'''
        )
        choice(
            name: 'GATE_SEVERITY_THRESHOLD',
            choices: ['CRITICAL', 'HIGH', 'MEDIUM', 'LOW'],
            description: 'Severity level that triggers the gate (block or detect). Default: CRITICAL'
        )
        booleanParam(
            name: 'UPLOAD_TO_DATADOG',
            defaultValue: true,
            description: 'Upload SAST + SCA results to Datadog (requires dd-api-key / dd-app-key credentials)'
        )
        booleanParam(
            name: 'UPLOAD_SARIF_TO_GITHUB',
            defaultValue: true,
            description: 'Upload SARIF to GitHub Code Scanning (requires github-token credential)'
        )
    }

    // ── Static environment ────────────────────────────────────────────────────
    environment {
        DD_SITE                  = 'datadoghq.com'
        // Service name used in Datadog — defaults to repo/folder name
        DD_SERVICE               = "${env.JOB_NAME.tokenize('/').first()}"
        SARIF_FILE               = 'static-analysis-results.sarif'
        STATIC_ANALYZER_VERSION  = '0.8.6'
        DATADOG_CI_VERSION       = '2.45.1'
        SBOM_GENERATOR_VERSION   = '1.14.0'
    }

    stages {

        // ── Stage 1: SAST Scan ────────────────────────────────────────────────
        stage('SAST Scan') {
            steps {
                echo "Running Datadog Static Analyzer v${STATIC_ANALYZER_VERSION}"
                sh """
                    docker run --rm \\
                        --memory=2g --cpus=2 \\
                        -v "\${WORKSPACE}:/code" \\
                        ghcr.io/datadog/datadog-static-analyzer:${STATIC_ANALYZER_VERSION} \\
                        -i /code \\
                        -o /code/${SARIF_FILE} \\
                        -f sarif
                """
                // Fail fast if SARIF was not produced (analyzer error)
                sh "test -f '${SARIF_FILE}' || (echo '::error::SARIF not produced'; exit 1)"
            }
        }

        // ── Stage 2: Quality Gate ─────────────────────────────────────────────
        stage('Quality Gate') {
            steps {
                script {
                    def flag = params.DETECT_ONLY ? '--detect-only' : ''
                    withEnv([
                        "DETECT_ONLY=${params.DETECT_ONLY}",
                        "GATE_SEVERITY_THRESHOLD=${params.GATE_SEVERITY_THRESHOLD}",
                        "SARIF_PATH=${SARIF_FILE}",
                    ]) {
                        sh "python3 .github/scripts/quality_gate.py ${flag}"
                    }
                }
            }
        }

        // ── Stage 3 + 4 + 5: Uploads (parallel) ─────────────────────────────
        stage('Upload Results') {
            parallel {

                // 3. SARIF → GitHub Code Scanning
                stage('SARIF → GitHub Code Scanning') {
                    when {
                        expression { return params.UPLOAD_SARIF_TO_GITHUB }
                    }
                    steps {
                        withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                            script {
                                // Parse owner/repo from Git remote URL
                                def remoteUrl = sh(script: "git remote get-url origin", returnStdout: true).trim()
                                def matcher = remoteUrl =~ /github\.com[:/]([^/]+)\/(.+?)(\.git)?$/
                                if (!matcher) {
                                    error "Cannot parse GitHub owner/repo from remote URL: ${remoteUrl}"
                                }
                                def owner = matcher[0][1]
                                def repo  = matcher[0][2]
                                def ref   = env.CHANGE_ID
                                    ? "refs/pull/${env.CHANGE_ID}/merge"
                                    : "refs/heads/${env.GIT_BRANCH?.replaceAll('^origin/', '')}"

                                sh """
                                    SARIF_B64=\$(gzip -c '${SARIF_FILE}' | base64 -w0)
                                    curl -sf -X POST \\
                                        -H "Authorization: token \${GITHUB_TOKEN}" \\
                                        -H "Accept: application/vnd.github+json" \\
                                        -H "X-GitHub-Api-Version: 2022-11-28" \\
                                        "https://api.github.com/repos/${owner}/${repo}/code-scanning/sarifs" \\
                                        -d "{\\
                                            \\"commit_sha\\":\\"${GIT_COMMIT}\\",\\
                                            \\"ref\\":\\"${ref}\\",\\
                                            \\"sarif\\":\\"\${SARIF_B64}\\",\\
                                            \\"tool_name\\":\\"Datadog SAST\\"\\
                                        }"
                                    echo "SARIF uploaded to GitHub Code Scanning"
                                """
                            }
                        }
                    }
                }

                // 4. SAST → Datadog
                // Reuses the SARIF produced in Stage 1 — no need to re-run the container.
                stage('SAST → Datadog Upload') {
                    when {
                        allOf {
                            expression { return params.UPLOAD_TO_DATADOG }
                            anyOf {
                                branch 'main'
                                branch 'master'
                                triggeredBy 'UserIdCause'
                            }
                        }
                    }
                    steps {
                        withCredentials([
                            string(credentialsId: 'dd-api-key', variable: 'DD_API_KEY'),
                            string(credentialsId: 'dd-app-key', variable: 'DD_APP_KEY'),
                        ]) {
                            sh """
                                # Download datadog-ci binary
                                curl -sfL \\
                                    "https://github.com/DataDog/datadog-ci/releases/download/v${DATADOG_CI_VERSION}/datadog-ci_linux-x64" \\
                                    -o datadog-ci-sast
                                chmod +x datadog-ci-sast

                                # Upload git metadata (powers PR commit linking in Datadog)
                                DD_API_KEY="\${DD_API_KEY}" DD_SITE="${DD_SITE}" \\
                                    ./datadog-ci-sast git-metadata upload

                                # Upload the SARIF already produced in SAST Scan stage
                                DD_API_KEY="\${DD_API_KEY}" DD_APP_KEY="\${DD_APP_KEY}" DD_SITE="${DD_SITE}" \\
                                    ./datadog-ci-sast sarif upload "${SARIF_FILE}" \\
                                    --service "${DD_SERVICE}" \\
                                    --env "${env.GIT_BRANCH?.replaceAll('^origin/', '') ?: 'unknown'}"
                            """
                        }
                    }
                }

                // 5. SCA → Datadog
                stage('SCA → Datadog Upload') {
                    when {
                        allOf {
                            expression { return params.UPLOAD_TO_DATADOG }
                            anyOf {
                                branch 'main'
                                branch 'master'
                                triggeredBy 'UserIdCause'
                            }
                        }
                    }
                    steps {
                        withCredentials([
                            string(credentialsId: 'dd-api-key', variable: 'DD_API_KEY'),
                            string(credentialsId: 'dd-app-key', variable: 'DD_APP_KEY'),
                        ]) {
                            sh """
                                # Download SBOM generator
                                curl -sfL \\
                                    "https://github.com/DataDog/datadog-sca-github-action/releases/download/v${SBOM_GENERATOR_VERSION}/datadog-sbom-generator-linux-amd64" \\
                                    -o datadog-sbom-generator
                                chmod +x datadog-sbom-generator

                                # Download datadog-ci binary (separate filename to avoid race with SAST stage)
                                curl -sfL \\
                                    "https://github.com/DataDog/datadog-ci/releases/download/v${DATADOG_CI_VERSION}/datadog-ci_linux-x64" \\
                                    -o datadog-ci-sca
                                chmod +x datadog-ci-sca

                                # Generate SBOM from all lock files
                                ./datadog-sbom-generator -p "\${WORKSPACE}" -o sbom.json

                                # Upload SBOM to Datadog
                                DD_API_KEY="\${DD_API_KEY}" DD_APP_KEY="\${DD_APP_KEY}" DD_SITE="${DD_SITE}" \\
                                    ./datadog-ci-sca sbom upload sbom.json \\
                                    --service "${DD_SERVICE}" \\
                                    --env "${env.GIT_BRANCH?.replaceAll('^origin/', '') ?: 'unknown'}"
                            """
                        }
                    }
                }

            } // end parallel
        } // end Upload Results

    } // end stages

    // ── Post-build actions ────────────────────────────────────────────────────
    post {
        always {
            // Archive SARIF regardless of gate outcome
            archiveArtifacts(
                artifacts: "${SARIF_FILE}",
                allowEmptyArchive: true,
                fingerprint: true,
            )
            // Clean up downloaded binaries
            sh "rm -f datadog-ci-sast datadog-ci-sca datadog-sbom-generator sbom.json || true"
        }
        success {
            echo "✅ Datadog Code Security pipeline PASSED"
        }
        failure {
            echo "❌ Datadog Code Security pipeline FAILED — check Quality Gate output above"
        }
        unstable {
            echo "⚠️  Datadog Code Security pipeline UNSTABLE"
        }
    }
}
