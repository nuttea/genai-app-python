// ─────────────────────────────────────────────────────────────────────────────
// Datadog Code Security — Jenkins Pipeline (Linux)
// Generic CI approach: https://docs.datadoghq.com/security/code_security/static_analysis/setup/generic_ci_providers/
//                      https://docs.datadoghq.com/security/code_security/software_composition_analysis/setup_static/generic_ci_providers/
//
// No Docker required. Uses native binaries for both the static analyzer and
// datadog-ci (via npm), following Datadog's official generic CI guide.
//
// Stages:
//   1. SAST Scan          — native binary, writes SARIF
//   2. Quality Gate       — parses SARIF with quality_gate.py
//   3. SARIF → GitHub     — uploads SARIF to GitHub Code Scanning (optional)
//   4. SAST → Datadog  ┐  — parallel, push/main branch only
//   5. SCA  → Datadog  ┘
//
// Required Jenkins credentials (Manage Jenkins → Credentials):
//   dd-api-key     Secret Text  — Datadog API key
//   dd-app-key     Secret Text  — Datadog Application key (code_analysis_read scope)
//   github-token   Secret Text  — GitHub token with security_events scope (optional)
//
// Required Jenkins plugins:
//   Pipeline, Credentials Binding, Git, Timestamper
//
// Agent requirements:
//   - Python 3.9+     (python3)
//   - Node.js 14+     (for npm install -g @datadog/datadog-ci)
//   - curl, unzip
//   - NO Docker required
// ─────────────────────────────────────────────────────────────────────────────

pipeline {
    agent { label 'linux' }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(daysToKeepStr: '30', numToKeepStr: '50'))
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        booleanParam(
            name: 'DETECT_ONLY',
            defaultValue: true,
            description: '''true  → virtual-fail mode: findings logged as warnings, CI never blocked
false → block mode: exits non-zero when violations at or above threshold exist'''
        )
        choice(
            name: 'GATE_SEVERITY_THRESHOLD',
            choices: ['CRITICAL', 'HIGH', 'MEDIUM', 'LOW'],
            description: 'Severity level that triggers the gate (block or detect). Default: CRITICAL'
        )
        booleanParam(
            name: 'UPLOAD_TO_DATADOG',
            defaultValue: true,
            description: 'Upload SAST + SCA results to Datadog'
        )
        booleanParam(
            name: 'UPLOAD_SARIF_TO_GITHUB',
            defaultValue: true,
            description: 'Upload SARIF to GitHub Code Scanning'
        )
    }

    environment {
        DD_SITE                  = 'datadoghq.com'
        DD_SERVICE               = "${env.JOB_NAME.tokenize('/').first()}"
        SARIF_FILE               = 'static-analysis-results.sarif'
        // Pin versions — update here to upgrade all downstream references
        STATIC_ANALYZER_VERSION  = '0.8.6'
        DATADOG_CI_VERSION       = '2.45.1'
        SBOM_GENERATOR_VERSION   = '1.14.0'
    }

    stages {

        // ── Stage 1: SAST Scan ────────────────────────────────────────────────
        // Downloads the native Linux binary and runs it against the workspace.
        // Docs: https://docs.datadoghq.com/security/code_security/static_analysis/setup/generic_ci_providers/
        stage('SAST Scan') {
            steps {
                sh """
                    # Download and extract the static analyzer native binary
                    ANALYZER_ZIP="/tmp/ddog-static-analyzer-\${BUILD_NUMBER}.zip"
                    curl -fsSL \\
                        "https://github.com/DataDog/datadog-static-analyzer/releases/download/${STATIC_ANALYZER_VERSION}/datadog-static-analyzer-x86_64-unknown-linux-gnu.zip" \\
                        -o "\${ANALYZER_ZIP}"
                    unzip -o "\${ANALYZER_ZIP}" -d /tmp/ddog-analyzer-\${BUILD_NUMBER}
                    chmod +x /tmp/ddog-analyzer-\${BUILD_NUMBER}/datadog-static-analyzer

                    # Run analysis — output is a SARIF file in the workspace
                    /tmp/ddog-analyzer-\${BUILD_NUMBER}/datadog-static-analyzer \\
                        -i "\${WORKSPACE}" \\
                        -o "\${WORKSPACE}/${SARIF_FILE}" \\
                        -f sarif

                    # Verify SARIF was produced
                    test -f "${SARIF_FILE}" || (echo "ERROR: SARIF not produced"; exit 1)
                    echo "SARIF produced: \$(wc -c < ${SARIF_FILE}) bytes"
                """
            }
        }

        // ── Stage 2: Quality Gate ─────────────────────────────────────────────
        stage('Quality Gate') {
            steps {
                script {
                    def flag = params.DETECT_ONLY ? '--detect-only' : ''
                    withEnv([
                        "DETECT_ONLY=${params.DETECT_ONLY}",
                        "GATE_SEVERITY_THRESHOLD=${params.GATE_SEVERITY_THRESHOLD}",
                        "SARIF_PATH=${SARIF_FILE}",
                    ]) {
                        sh "python3 .github/scripts/quality_gate.py ${flag}"
                    }
                }
            }
        }

        // ── Stage 3 + 4 + 5: Uploads (parallel) ─────────────────────────────
        stage('Upload Results') {
            parallel {

                // 3. SARIF → GitHub Code Scanning
                stage('SARIF → GitHub Code Scanning') {
                    when {
                        expression { return params.UPLOAD_SARIF_TO_GITHUB }
                    }
                    steps {
                        withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                            script {
                                def remoteUrl = sh(script: "git remote get-url origin", returnStdout: true).trim()
                                def matcher   = remoteUrl =~ /github\.com[:/]([^/]+)\/(.+?)(\.git)?$/
                                if (!matcher) {
                                    error "Cannot parse GitHub owner/repo from remote URL: ${remoteUrl}"
                                }
                                def owner = matcher[0][1]
                                def repo  = matcher[0][2]
                                def ref   = env.CHANGE_ID
                                    ? "refs/pull/${env.CHANGE_ID}/merge"
                                    : "refs/heads/${env.GIT_BRANCH?.replaceAll('^origin/', '')}"

                                sh """
                                    SARIF_B64=\$(gzip -c '${SARIF_FILE}' | base64 -w0)
                                    curl -sf -X POST \\
                                        -H "Authorization: token \${GITHUB_TOKEN}" \\
                                        -H "Accept: application/vnd.github+json" \\
                                        -H "X-GitHub-Api-Version: 2022-11-28" \\
                                        "https://api.github.com/repos/${owner}/${repo}/code-scanning/sarifs" \\
                                        -d "{\\
                                            \\"commit_sha\\":\\"${GIT_COMMIT}\\",\\
                                            \\"ref\\":\\"${ref}\\",\\
                                            \\"sarif\\":\\"\${SARIF_B64}\\",\\
                                            \\"tool_name\\":\\"Datadog SAST\\"\\
                                        }"
                                    echo "SARIF uploaded to GitHub Code Scanning"
                                """
                            }
                        }
                    }
                }

                // 4. SAST → Datadog
                // Installs datadog-ci via npm (official recommendation), uploads git metadata
                // and the SARIF produced in Stage 1.
                stage('SAST → Datadog Upload') {
                    when {
                        allOf {
                            expression { return params.UPLOAD_TO_DATADOG }
                            anyOf {
                                branch 'main'
                                branch 'master'
                                triggeredBy 'UserIdCause'
                            }
                        }
                    }
                    steps {
                        withCredentials([
                            string(credentialsId: 'dd-api-key', variable: 'DD_API_KEY'),
                            string(credentialsId: 'dd-app-key', variable: 'DD_APP_KEY'),
                        ]) {
                            sh """
                                # Install datadog-ci via npm (requires Node.js 14+)
                                npm install -g @datadog/datadog-ci@${DATADOG_CI_VERSION} --silent

                                export DD_API_KEY="\${DD_API_KEY}"
                                export DD_APP_KEY="\${DD_APP_KEY}"
                                export DD_SITE="${DD_SITE}"

                                # Upload git metadata — enables diff-aware scanning and PR commit linking
                                datadog-ci git-metadata upload

                                # Upload the SARIF already produced in SAST Scan stage
                                BRANCH="\$(echo "\${GIT_BRANCH:-}" | sed 's|^origin/||')"
                                datadog-ci sarif upload "${SARIF_FILE}" \\
                                    --service "${DD_SERVICE}" \\
                                    --env "\${BRANCH:-unknown}"
                            """
                        }
                    }
                }

                // 5. SCA → Datadog
                stage('SCA → Datadog Upload') {
                    when {
                        allOf {
                            expression { return params.UPLOAD_TO_DATADOG }
                            anyOf {
                                branch 'main'
                                branch 'master'
                                triggeredBy 'UserIdCause'
                            }
                        }
                    }
                    steps {
                        withCredentials([
                            string(credentialsId: 'dd-api-key', variable: 'DD_API_KEY'),
                            string(credentialsId: 'dd-app-key', variable: 'DD_APP_KEY'),
                        ]) {
                            sh """
                                # Install datadog-ci via npm
                                npm install -g @datadog/datadog-ci@${DATADOG_CI_VERSION} --silent

                                # Download SBOM generator native binary
                                curl -fsSL \\
                                    "https://github.com/DataDog/datadog-sca-github-action/releases/download/v${SBOM_GENERATOR_VERSION}/datadog-sbom-generator-linux-amd64" \\
                                    -o /tmp/datadog-sbom-generator-\${BUILD_NUMBER}
                                chmod +x /tmp/datadog-sbom-generator-\${BUILD_NUMBER}

                                # Generate SBOM from all lock files
                                /tmp/datadog-sbom-generator-\${BUILD_NUMBER} \\
                                    -p "\${WORKSPACE}" \\
                                    -o sbom.json

                                export DD_API_KEY="\${DD_API_KEY}"
                                export DD_APP_KEY="\${DD_APP_KEY}"
                                export DD_SITE="${DD_SITE}"

                                BRANCH="\$(echo "\${GIT_BRANCH:-}" | sed 's|^origin/||')"
                                datadog-ci sbom upload sbom.json \\
                                    --service "${DD_SERVICE}" \\
                                    --env "\${BRANCH:-unknown}"
                            """
                        }
                    }
                }

            } // end parallel
        } // end Upload Results

    } // end stages

    post {
        always {
            archiveArtifacts(
                artifacts: "${SARIF_FILE}",
                allowEmptyArchive: true,
                fingerprint: true,
            )
            // Clean up temp files
            sh """
                rm -f sbom.json || true
                rm -rf /tmp/ddog-analyzer-\${BUILD_NUMBER} /tmp/ddog-static-analyzer-\${BUILD_NUMBER}.zip \\
                       /tmp/datadog-sbom-generator-\${BUILD_NUMBER} || true
            """
        }
        success {
            echo "SUCCESS: Datadog Code Security pipeline PASSED"
        }
        failure {
            echo "FAILED: Datadog Code Security pipeline FAILED — check Quality Gate output above"
        }
    }
}
