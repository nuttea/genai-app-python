// ─────────────────────────────────────────────────────────────────────────────
// Datadog Code Security — Jenkins Pipeline (Windows Server)
// Generic CI approach: https://docs.datadoghq.com/security/code_security/static_analysis/setup/generic_ci_providers/
//                      https://docs.datadoghq.com/security/code_security/software_composition_analysis/setup_static/generic_ci_providers/
//
// No Docker required. Uses native Windows binaries for the static analyzer
// and datadog-ci via npm, following Datadog's official generic CI guide.
//
// Stages:
//   1. SAST Scan          — native Windows binary, writes SARIF
//   2. Quality Gate       — parses SARIF with quality_gate.py
//   3. SARIF → GitHub     — uploads SARIF to GitHub Code Scanning (optional)
//   4. SAST → Datadog  ┐  — parallel, push/main branch only
//   5. SCA  → Datadog  ┘
//
// Required Jenkins credentials (Manage Jenkins → Credentials):
//   dd-api-key     Secret Text  — Datadog API key
//   dd-app-key     Secret Text  — Datadog Application key (code_analysis_read scope)
//   github-token   Secret Text  — GitHub token with security_events scope (optional)
//
// Required Jenkins plugins:
//   Pipeline, Credentials Binding, Git, Timestamper
//
// Agent requirements:
//   - Python 3.9+   on PATH as `python`
//   - Node.js 14+   on PATH (for npm install -g @datadog/datadog-ci)
//   - PowerShell 5.1+ (ships with Windows Server 2016+)
//   - NO Docker required
// ─────────────────────────────────────────────────────────────────────────────

pipeline {
    agent { label 'windows' }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(daysToKeepStr: '30', numToKeepStr: '50'))
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        booleanParam(
            name: 'DETECT_ONLY',
            defaultValue: true,
            description: '''true  → virtual-fail mode: findings logged as warnings, CI never blocked
false → block mode: exits non-zero when violations at or above threshold exist'''
        )
        choice(
            name: 'GATE_SEVERITY_THRESHOLD',
            choices: ['CRITICAL', 'HIGH', 'MEDIUM', 'LOW'],
            description: 'Severity level that triggers the gate (block or detect). Default: CRITICAL'
        )
        booleanParam(
            name: 'UPLOAD_TO_DATADOG',
            defaultValue: true,
            description: 'Upload SAST + SCA results to Datadog'
        )
        booleanParam(
            name: 'UPLOAD_SARIF_TO_GITHUB',
            defaultValue: true,
            description: 'Upload SARIF to GitHub Code Scanning'
        )
    }

    environment {
        DD_SITE                  = 'datadoghq.com'
        DD_SERVICE               = "${env.JOB_NAME.tokenize('/').first()}"
        SARIF_FILE               = 'static-analysis-results.sarif'
        STATIC_ANALYZER_VERSION  = '0.8.6'
        DATADOG_CI_VERSION       = '2.45.1'
        SBOM_GENERATOR_VERSION   = '1.14.0'
    }

    stages {

        // ── Stage 1: SAST Scan ────────────────────────────────────────────────
        // Downloads the native Windows binary and runs it against the workspace.
        // Docs: https://docs.datadoghq.com/security/code_security/static_analysis/setup/generic_ci_providers/
        stage('SAST Scan') {
            steps {
                powershell """
                    \$ErrorActionPreference = 'Stop'

                    # Download and extract the static analyzer native Windows binary
                    \$analyzerZip  = "\$env:TEMP\\ddog-static-analyzer-\${env:BUILD_NUMBER}.zip"
                    \$analyzerDir  = "\$env:TEMP\\ddog-analyzer-\${env:BUILD_NUMBER}"
                    \$analyzerUrl  = "https://github.com/DataDog/datadog-static-analyzer/releases/download/${STATIC_ANALYZER_VERSION}/datadog-static-analyzer-x86_64-pc-windows-msvc.zip"

                    Write-Host "Downloading static analyzer v${STATIC_ANALYZER_VERSION}..."
                    Invoke-WebRequest -Uri \$analyzerUrl -OutFile \$analyzerZip -UseBasicParsing

                    if (Test-Path \$analyzerDir) { Remove-Item -Recurse -Force \$analyzerDir }
                    Expand-Archive -Path \$analyzerZip -DestinationPath \$analyzerDir -Force

                    \$analyzerExe = Join-Path \$analyzerDir "datadog-static-analyzer.exe"
                    if (-not (Test-Path \$analyzerExe)) {
                        Write-Error "Analyzer binary not found at \$analyzerExe"
                        exit 1
                    }

                    # Run analysis — output is a SARIF file in the workspace
                    Write-Host "Running static analysis..."
                    & \$analyzerExe `
                        -i "\${env:WORKSPACE}" `
                        -o "\${env:WORKSPACE}\\${SARIF_FILE}" `
                        -f sarif

                    if (\$LASTEXITCODE -ne 0) {
                        Write-Error "Static analyzer exited with code \$LASTEXITCODE"
                        exit \$LASTEXITCODE
                    }

                    if (-not (Test-Path "${SARIF_FILE}")) {
                        Write-Error "SARIF not produced — static analyzer may have failed"
                        exit 1
                    }
                    \$sarif_size = (Get-Item "${SARIF_FILE}").Length
                    Write-Host "SARIF produced: \$sarif_size bytes"
                """
            }
        }

        // ── Stage 2: Quality Gate ─────────────────────────────────────────────
        stage('Quality Gate') {
            steps {
                script {
                    def flag = params.DETECT_ONLY ? '--detect-only' : ''
                    withEnv([
                        "DETECT_ONLY=${params.DETECT_ONLY}",
                        "GATE_SEVERITY_THRESHOLD=${params.GATE_SEVERITY_THRESHOLD}",
                        "SARIF_PATH=${SARIF_FILE}",
                    ]) {
                        // Use `python` (Windows PATH default); change to `py -3` if needed
                        powershell "python .github/scripts/quality_gate.py ${flag}"
                    }
                }
            }
        }

        // ── Stage 3 + 4 + 5: Uploads (parallel) ─────────────────────────────
        stage('Upload Results') {
            parallel {

                // 3. SARIF → GitHub Code Scanning
                stage('SARIF → GitHub Code Scanning') {
                    when {
                        expression { return params.UPLOAD_SARIF_TO_GITHUB }
                    }
                    steps {
                        withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                            script {
                                def remoteUrl = powershell(
                                    script: "git remote get-url origin",
                                    returnStdout: true
                                ).trim()
                                def matcher = remoteUrl =~ /github\.com[:/]([^/]+)\/(.+?)(\.git)?$/
                                if (!matcher) {
                                    error "Cannot parse GitHub owner/repo from remote URL: ${remoteUrl}"
                                }
                                def owner = matcher[0][1]
                                def repo  = matcher[0][2]
                                def ref   = env.CHANGE_ID
                                    ? "refs/pull/${env.CHANGE_ID}/merge"
                                    : "refs/heads/${env.GIT_BRANCH?.replaceAll('^origin/', '')}"

                                withEnv(["GH_OWNER=${owner}", "GH_REPO=${repo}", "GH_REF=${ref}"]) {
                                    powershell """
                                        \$ErrorActionPreference = 'Stop'

                                        \$sarifBytes = [System.IO.File]::ReadAllBytes("${SARIF_FILE}")
                                        \$mem        = [System.IO.MemoryStream]::new()
                                        \$gz         = [System.IO.Compression.GZipStream]::new(\$mem, [System.IO.Compression.CompressionMode]::Compress)
                                        \$gz.Write(\$sarifBytes, 0, \$sarifBytes.Length)
                                        \$gz.Close()
                                        \$sarifB64 = [Convert]::ToBase64String(\$mem.ToArray())

                                        \$body = @{
                                            commit_sha = "\${env:GIT_COMMIT}"
                                            ref        = "\${env:GH_REF}"
                                            sarif      = \$sarifB64
                                            tool_name  = "Datadog SAST"
                                        } | ConvertTo-Json -Depth 5

                                        \$headers = @{
                                            Authorization            = "token \${env:GITHUB_TOKEN}"
                                            Accept                   = "application/vnd.github+json"
                                            "X-GitHub-Api-Version"   = "2022-11-28"
                                        }

                                        Invoke-RestMethod `
                                            -Method POST `
                                            -Uri "https://api.github.com/repos/\${env:GH_OWNER}/\${env:GH_REPO}/code-scanning/sarifs" `
                                            -Headers \$headers `
                                            -Body \$body `
                                            -ContentType "application/json" `
                                            -ErrorAction Stop

                                        Write-Host "SARIF uploaded to GitHub Code Scanning"
                                    """
                                }
                            }
                        }
                    }
                }

                // 4. SAST → Datadog
                // Installs datadog-ci via npm, uploads git metadata and the SARIF from Stage 1.
                stage('SAST → Datadog Upload') {
                    when {
                        allOf {
                            expression { return params.UPLOAD_TO_DATADOG }
                            anyOf {
                                branch 'main'
                                branch 'master'
                                triggeredBy 'UserIdCause'
                            }
                        }
                    }
                    steps {
                        withCredentials([
                            string(credentialsId: 'dd-api-key', variable: 'DD_API_KEY'),
                            string(credentialsId: 'dd-app-key', variable: 'DD_APP_KEY'),
                        ]) {
                            powershell """
                                \$ErrorActionPreference = 'Stop'

                                # Install datadog-ci via npm (requires Node.js 14+)
                                npm install -g "@datadog/datadog-ci@${DATADOG_CI_VERSION}" --silent
                                if (\$LASTEXITCODE -ne 0) { Write-Error "npm install failed"; exit \$LASTEXITCODE }

                                \$env:DD_API_KEY = "\${env:DD_API_KEY}"
                                \$env:DD_APP_KEY = "\${env:DD_APP_KEY}"
                                \$env:DD_SITE    = "${DD_SITE}"

                                # Upload git metadata — enables diff-aware scanning and PR commit linking
                                datadog-ci git-metadata upload
                                if (\$LASTEXITCODE -ne 0) {
                                    Write-Warning "git-metadata upload failed (exit \$LASTEXITCODE) — continuing"
                                }

                                # Upload the SARIF already produced in Stage 1
                                \$branch = ("\${env:GIT_BRANCH}" -replace '^origin/', '')
                                datadog-ci sarif upload "${SARIF_FILE}" `
                                    --service "${DD_SERVICE}" `
                                    --env "\$branch"
                                if (\$LASTEXITCODE -ne 0) {
                                    Write-Error "SARIF upload to Datadog failed (exit \$LASTEXITCODE)"
                                    exit \$LASTEXITCODE
                                }
                            """
                        }
                    }
                }

                // 5. SCA → Datadog
                stage('SCA → Datadog Upload') {
                    when {
                        allOf {
                            expression { return params.UPLOAD_TO_DATADOG }
                            anyOf {
                                branch 'main'
                                branch 'master'
                                triggeredBy 'UserIdCause'
                            }
                        }
                    }
                    steps {
                        withCredentials([
                            string(credentialsId: 'dd-api-key', variable: 'DD_API_KEY'),
                            string(credentialsId: 'dd-app-key', variable: 'DD_APP_KEY'),
                        ]) {
                            powershell """
                                \$ErrorActionPreference = 'Stop'

                                # Install datadog-ci via npm
                                npm install -g "@datadog/datadog-ci@${DATADOG_CI_VERSION}" --silent
                                if (\$LASTEXITCODE -ne 0) { Write-Error "npm install failed"; exit \$LASTEXITCODE }

                                # Download SBOM generator (DataDog/datadog-sbom-generator)
                                \$sbomZip = "\$env:TEMP\\datadog-sbom-generator-\${env:BUILD_NUMBER}.zip"
                                \$sbomDir = "\$env:TEMP\\datadog-sbom-generator-dir-\${env:BUILD_NUMBER}"
                                \$sbomUrl = "https://github.com/DataDog/datadog-sbom-generator/releases/download/v${SBOM_GENERATOR_VERSION}/datadog-sbom-generator_windows_amd64.zip"
                                Invoke-WebRequest -Uri \$sbomUrl -OutFile \$sbomZip -UseBasicParsing
                                if (Test-Path \$sbomDir) { Remove-Item -Recurse -Force \$sbomDir }
                                Expand-Archive -Path \$sbomZip -DestinationPath \$sbomDir -Force
                                \$sbomExe = Join-Path \$sbomDir "datadog-sbom-generator.exe"

                                # Generate SBOM from the workspace
                                Push-Location "\${env:WORKSPACE}"
                                & \$sbomExe scan --verbosity info --output=sbom.json .
                                Pop-Location
                                if (\$LASTEXITCODE -ne 0) {
                                    Write-Error "SBOM generation failed (exit \$LASTEXITCODE)"
                                    exit \$LASTEXITCODE
                                }

                                \$env:DD_API_KEY = "\${env:DD_API_KEY}"
                                \$env:DD_APP_KEY = "\${env:DD_APP_KEY}"
                                \$env:DD_SITE    = "${DD_SITE}"

                                \$branch = ("\${env:GIT_BRANCH}" -replace '^origin/', '')
                                datadog-ci sbom upload sbom.json `
                                    --service "${DD_SERVICE}" `
                                    --env "\$branch"
                                if (\$LASTEXITCODE -ne 0) {
                                    Write-Error "SBOM upload to Datadog failed (exit \$LASTEXITCODE)"
                                    exit \$LASTEXITCODE
                                }
                            """
                        }
                    }
                }

            } // end parallel
        } // end Upload Results

    } // end stages

    post {
        always {
            archiveArtifacts(
                artifacts: "${SARIF_FILE}",
                allowEmptyArchive: true,
                fingerprint: true,
            )
            powershell """
                Remove-Item -Force -ErrorAction SilentlyContinue sbom.json
                Remove-Item -Recurse -Force -ErrorAction SilentlyContinue `
                    "\$env:TEMP\\ddog-analyzer-\${env:BUILD_NUMBER}", `
                    "\$env:TEMP\\ddog-static-analyzer-\${env:BUILD_NUMBER}.zip", `
                    "\$env:TEMP\\datadog-sbom-generator-\${env:BUILD_NUMBER}.zip", `
                    "\$env:TEMP\\datadog-sbom-generator-dir-\${env:BUILD_NUMBER}"
            """
        }
        success {
            echo "SUCCESS: Datadog Code Security pipeline PASSED"
        }
        failure {
            echo "FAILED: Datadog Code Security pipeline FAILED — check Quality Gate output above"
        }
    }
}
